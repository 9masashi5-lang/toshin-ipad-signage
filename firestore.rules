rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidRankingEntry(entry) {
      return entry is map
        && entry.keys().hasOnly(['id', 'name', 'score'])
        && entry.id is string
        && entry.name is string
        && (entry.score is string || entry.score is number);
    }

    function hasValidRankingEntries(entries) {
      return entries is list
        && entries.size() >= 1
        && entries.size() <= 10
        && isValidRankingEntry(entries[0])
        && (entries.size() < 2 || isValidRankingEntry(entries[1]))
        && (entries.size() < 3 || isValidRankingEntry(entries[2]))
        && (entries.size() < 4 || isValidRankingEntry(entries[3]))
        && (entries.size() < 5 || isValidRankingEntry(entries[4]))
        && (entries.size() < 6 || isValidRankingEntry(entries[5]))
        && (entries.size() < 7 || isValidRankingEntry(entries[6]))
        && (entries.size() < 8 || isValidRankingEntry(entries[7]))
        && (entries.size() < 9 || isValidRankingEntry(entries[8]))
        && (entries.size() < 10 || isValidRankingEntry(entries[9]));
    }

    function isValidRanking(ranking) {
      return ranking is map
        && ranking.keys().hasOnly(['title', 'backgroundTheme', 'entries'])
        && ranking.title is string
        && (
          !ranking.keys().hasAny(['backgroundTheme'])
          || ranking.backgroundTheme in ['navy', 'blue', 'green', 'red', 'gold', 'light']
        )
        && hasValidRankingEntries(ranking.entries);
    }

    function hasValidRankingSlides(slides) {
      // 管理者だけが書き込める前提で、ここでは枚数だけを検証する。
      // 全スライド・全項目を個別検証すると、枚数増加時に
      // Firestore Security Rules の評価上限へ達して保存に失敗するため。
      return slides is list
        && slides.size() >= 1
        && slides.size() <= 10;
    }

    function hasValidSignageShape() {
      return request.resource.data.keys().hasOnly([
          'mode', 'ranking', 'rankingSlides', 'notice', 'countdown', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'mode', 'ranking', 'notice', 'countdown', 'updatedAt'
        ])
        && request.resource.data.mode in ['ranking', 'notice', 'countdown']
        && isValidRanking(request.resource.data.ranking)
        && (
          !request.resource.data.keys().hasAny(['rankingSlides'])
          || hasValidRankingSlides(request.resource.data.rankingSlides)
        )
        && request.resource.data.notice is map
        && request.resource.data.notice.keys().hasOnly(['title', 'message'])
        && request.resource.data.notice.title is string
        && request.resource.data.notice.message is string
        && request.resource.data.countdown is map
        && request.resource.data.countdown.keys().hasOnly(['title', 'targetDate', 'message'])
        && request.resource.data.countdown.title is string
        && request.resource.data.countdown.targetDate is string
        && request.resource.data.countdown.message is string
        && request.resource.data.updatedAt is timestamp;
    }

    match /signage/current {
      allow read: if true;
      allow create, update: if isAdmin() && hasValidSignageShape();
      allow delete: if false;
    }

    match /admins/{uid} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
